# Copy to .env ONLY when running with compose.aiven.yaml.
# Do not commit the populated .env or any certificates.
ENVIRONMENT=development
WEB_BIND=127.0.0.1
JWT_SECRET=REPLACE_WITH_64_CHARACTER_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
CORS_ORIGINS=http://localhost:8080
DATABASE_URL=postgresql+psycopg://avnadmin:URL_ENCODED_PASSWORD@PG_HOST:PG_PORT/defaultdb?sslmode=verify-full&sslrootcert=/run/secrets/ca.pem
KAFKA_BOOTSTRAP_SERVERS=KAFKA_HOST:KAFKA_PORT
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_CA_FILE=/run/secrets/ca.pem
KAFKA_CERT_FILE=/run/secrets/service.cert
KAFKA_KEY_FILE=/run/secrets/service.key
KAFKA_TOPIC=store.events
OPENSEARCH_URL=https://SEARCH_HOST:SEARCH_PORT
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=REPLACE_WITH_AIVEN_SEARCH_PASSWORD
OPENSEARCH_CA_FILE=/run/secrets/ca.pem
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to your actual public HTTPS storefront origin in production.
PUBLIC_BASE_URL=https://your-store.example
