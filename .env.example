ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://store:store@postgres:5432/store
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET_GENERATED_WITH_OPENSSL
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC=store.events
OPENSEARCH_URL=http://opensearch:9200
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
# Aiven: use postgresql+psycopg://...?... sslmode=verify-full&sslrootcert=/run/secrets/ca.pem
# KAFKA_SECURITY_PROTOCOL=SSL
# KAFKA_CA_FILE=/run/secrets/ca.pem
# KAFKA_CERT_FILE=/run/secrets/service.cert
# KAFKA_KEY_FILE=/run/secrets/service.key
# OPENSEARCH_URL=https://host:port
# OPENSEARCH_USERNAME=avnadmin
# OPENSEARCH_PASSWORD=...
# OPENSEARCH_CA_FILE=/run/secrets/ca.pem

# Local web binding: set WEB_BIND=0.0.0.0 only behind HTTPS reverse proxy
WEB_BIND=127.0.0.1
GRAFANA_ADMIN_PASSWORD=change-me-local-only
